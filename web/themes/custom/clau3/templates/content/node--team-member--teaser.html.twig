{#
/**
 * @file
 * Team member (node) as shown in the About page grid: round photo, name,
 * role. Successor of taxonomy-term--musical-team.html.twig; the view
 * "Team members" renders team_member nodes in the teaser view mode with it.
 */
#}
<div{{ attributes.addClass('ligc-musical-team-grid-item') }}>
  {% if team_image_url %}
    <div class="ligc-term-img">
      <img src="{{ team_image_url }}" width="400" height="400" loading="lazy" alt="{{ node.label }}"/>
    </div>
  {% endif %}
  <div class="ligc-term-content">
    <h2>{{ node.label }}</h2>
    <div class="ligc-term-desc">
      {{ node.field_role.value }}
    </div>
  </div>
</div>
