{#
/**
 * @file
 * The front page: its paragraphs, edge to edge. The hero paragraph provides
 * the top of the page, so the old full-page background image is gone.
 */
#}
<article{{ attributes.addClass(['node', 'node--type-home', 'node--view-mode-full']) }}>
  <div{{ content_attributes.addClass('node__content') }}>
    {{ content|without('field_background_media') }}
  </div>
</article>
