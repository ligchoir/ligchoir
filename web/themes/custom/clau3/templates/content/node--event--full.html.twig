{#
/**
 * @file
 * One event. Variables from clau3_preprocess_node() for the full view mode:
 * event_image, event_when, event_venue, event_is_past, event_tickets_*.
 */
#}
{% embed 'clau3:event-page' with {
  title: label,
  scheme: node.field_colour_scheme.value|default('paper'),
  is_past: event_is_past,
  when: event_when|default(''),
  venue: event_venue|default(''),
  tickets_url: event_tickets_url|default(''),
  tickets_label: event_tickets_label|default(''),
  tickets_domain: event_tickets_domain|default(''),
  projects: event_projects|default([]),
} %}
  {% block image %}{{ event_image }}{% endblock %}
  {% block body %}{{ content.body }}{% endblock %}
{% endembed %}
