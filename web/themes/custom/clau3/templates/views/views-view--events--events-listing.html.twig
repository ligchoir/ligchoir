{#
/**
 * @file
 * The events "events_listing" display on the Events & News page: every
 * upcoming event as the same card as the front page grid (review round 3,
 * A29). No heading of its own (the hero and the strip above it do that
 * job). The grid ends with a "Past events" card in the same shape as the
 * event cards (Rob, 2026-11-10), which replaced the footer link.
 *
 * The past events page ("block_events_past" display) includes this
 * template, so both lists are the same grid; the listing ends with a Past
 * events card and the archive with an Events & News card.
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    'events-cards',
    'events-cards--listing',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<section{{ attributes.addClass(classes) }}>
  {{ title_prefix }}{{ title }}{{ title_suffix }}
  {% if header %}
    <div class="events-cards__header">{{ header }}</div>
  {% endif %}
  {% if empty and not rows %}
    <div class="events-cards__empty">{{ empty }}</div>
  {% endif %}
  <div class="events-cards__grid">
    {{ rows }}
    {# The archive as one more card: the brand mark on slate like events
       without a photo, with the link text where the date would be. #}
    {% if display_id == 'events_listing' %}
    <article class="event-card event-card--past">
      <a class="event-card__link" href="/events/past-events">
        <div class="event-card__media event-card__media--empty"></div>
        <div class="event-card__body">
          <div class="event-card__date">{{ 'Since 2021'|t }}</div>
          <h3 class="event-card__title">{{ 'Past events'|t }}</h3>
          <p class="event-card__venue">{{ 'Concerts, services and festivals we have sung at'|t }}</p>
        </div>
      </a>
    </article>
    {% elseif display_id == 'block_events_past' %}
    <article class="event-card event-card--past">
      <a class="event-card__link" href="/events-news">
        <div class="event-card__media event-card__media--empty"></div>
        <div class="event-card__body">
          <div class="event-card__date">{{ 'Coming up'|t }}</div>
          <h3 class="event-card__title">{{ 'Events & News'|t }}</h3>
          <p class="event-card__venue">{{ 'Where to hear us next'|t }}</p>
        </div>
      </a>
    </article>
    {% endif %}
  </div>
  {{ pager }}
  {% if footer %}
    <div class="events-cards__footer">{{ footer }}</div>
  {% endif %}
</section>
