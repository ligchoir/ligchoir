{#
/**
 * @file
 * The events "cards" display: heading, grid of event cards, View all link.
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    'events-cards',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<section{{ attributes.addClass(classes) }}>
  {{ title_prefix }}{{ title }}{{ title_suffix }}
  {% if header %}<div class="events-cards__header">{{ header }}</div>{% endif %}
  {% if rows %}
    <div class="events-cards__grid">{{ rows }}</div>
  {% elseif empty %}
    <div class="events-cards__empty">{{ empty }}</div>
  {% endif %}
  {% if more %}<div class="events-cards__more">{{ more }}</div>{% endif %}
</section>
