<?php

/**
 * @file
 * Clau3 theme hooks. Design brief: docs/frontend/new-theme-plan.md.
 */

use Drupal\image\Entity\ImageStyle;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function clau3_preprocess_html(array &$variables): void {
  if (_clau3_system_page()) {
    $variables['attributes']['class'][] = 'page-system';
  }
  // Absolute path to the theme for the font preloads in html.html.twig.
  // ("directory" alone is relative and broke on two-segment paths such as
  // /search/node, where it resolved to /search/themes/... and 404ed.)
  $variables['clau3_theme_path'] = \Drupal::request()->getBasePath() . '/' . \Drupal::service('extension.list.theme')->getPath('clau3');
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function clau3_preprocess_page(array &$variables): void {
  $variables['clau3_site_name'] = \Drupal::config('system.site')->get('name');
  $variables['clau3_year'] = date('Y');
  $variables['system_page'] = _clau3_system_page();
}

/**
 * Drupal's bare pages get a heading, an intro and useful links.
 *
 * @return array|null
 *   Keys: key, title, intro, links (label => path), replace_content.
 */
function _clau3_system_page(): ?array {
  $pages = [
    'user.login' => [
      'key' => 'login',
      'title' => t('Log in'),
      'intro' => t('For the choir team who edit the website.'),
      'links' => [(string) t('Forgotten your password?') => '/user/password'],
    ],
    'user.pass' => [
      'key' => 'password',
      'title' => t('Reset your password'),
      'intro' => t('Enter your username or email address and we will send you a link to set a new password.'),
      'links' => [(string) t('Back to log in') => '/user/login'],
    ],
    'system.404' => [
      'key' => '404',
      'title' => t('Page not found'),
      'intro' => t('Sorry, there is no page at this address. It may have moved, or the link may be out of date.'),
      'links' => [
        (string) t('Home') => '/',
        (string) t('Events') => '/events',
        (string) t('About us') => '/about',
        (string) t('Join us') => '/join',
        (string) t('Book us') => '/book',
      ],
      'replace_content' => TRUE,
    ],
    'system.403' => [
      'key' => '403',
      'title' => t('You need to log in to see this page'),
      'intro' => t('This page is not public. If you are part of the team, log in and try again.'),
      'links' => [(string) t('Log in') => '/user/login', (string) t('Home') => '/'],
      'replace_content' => TRUE,
    ],
  ];
  $route = \Drupal::routeMatch()->getRouteName();
  return $pages[$route] ?? NULL;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block templates.
 *
 * Adds block--block-content--BUNDLE so a custom block type can have one
 * template whichever block instance renders it.
 */
function clau3_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $content = $variables['elements']['content'] ?? [];
  if (!empty($content['#block_content'])) {
    $bundle = $content['#block_content']->bundle();
    $suggestions[] = 'block__block_content__' . $bundle;
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * LEGACY (from clau2): the home template uses the background_image_xl styled
 * URL of the node's background media. Goes with the hero paragraph (plan
 * section 15, step 3).
 */
function clau3_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node) {
    return;
  }
  // Event page: image through the hero style, date line, organiser link
  // (future events only), colour scheme class.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'full') {
    _clau3_preprocess_event_full($variables, $node);
    return;
  }
  // Front page events grid: image through the card responsive style, date field.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'event_card') {
    $variables['event_card_image'] = _clau3_responsive_media($node, 'field_background_media', 'card');
    $variables['event_card_date'] = $variables['content']['field_when'] ?? [];
    return;
  }
  // Events landing pages: the Upcoming / Past / Map strip.
  if ($node->bundle() === 'landing_page' && ($variables['view_mode'] ?? '') === 'full') {
    $variables['section_strip'] = _clau3_events_strip($node->toUrl()->toString());
  }
  // Team grid: the round portrait through the square_400 style (WebP, focal
  // point) instead of the original upload.
  if ($node->bundle() === 'team_member' && ($variables['view_mode'] ?? '') === 'teaser') {
    $variables['team_image_url'] = _clau3_styled_media_url($node, 'field_image', 'square_400');
    return;
  }
  if ($node->bundle() !== 'home' || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $variables['bg_img_styled_url'] = NULL;
  if (!$node->hasField('field_background_media') || $node->get('field_background_media')->isEmpty()) {
    return;
  }
  $media = $node->get('field_background_media')->entity;
  if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return;
  }
  $file = $media->get('field_media_image')->entity;
  $style = ImageStyle::load('background_image_xl');
  if ($file && $style) {
    $url = $style->buildUrl($file->getFileUri());
    $variables['bg_img_styled_url'] = \Drupal::service('file_url_generator')->transformRelative($url);
  }
}

/**
 * Relative URL of an image style derivative for a media image field on an entity.
 */
function _clau3_styled_media_url($entity, string $field, string $style_name): ?string {
  if (!$entity->hasField($field) || $entity->get($field)->isEmpty()) {
    return NULL;
  }
  $media = $entity->get($field)->entity;
  if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return NULL;
  }
  $file = $media->get('field_media_image')->entity;
  $style = ImageStyle::load($style_name);
  if (!$file || !$style) {
    return NULL;
  }
  return \Drupal::service('file_url_generator')->transformRelative($style->buildUrl($file->getFileUri()));
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--hero.html.twig.
 */
function clau3_preprocess_paragraph__hero(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['hero_poster_url'] = _clau3_styled_media_url($paragraph, 'field_image', 'wide_1600');
  $variables['hero_poster_alt'] = '';
  if (!$paragraph->get('field_image')->isEmpty() && ($media = $paragraph->get('field_image')->entity)) {
    $variables['hero_poster_alt'] = $media->get('field_media_image')->alt ?? '';
  }
  $variables['hero_video_url'] = NULL;
  if ($paragraph->hasField('field_video') && !$paragraph->get('field_video')->isEmpty()) {
    $media = $paragraph->get('field_video')->entity;
    if ($media && $media->hasField('field_media_video_file') && !$media->get('field_media_video_file')->isEmpty()) {
      $file = $media->get('field_media_video_file')->entity;
      if ($file) {
        $variables['hero_video_url'] = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
      }
    }
  }
  $variables['hero_text'] = $variables['content']['field_text'] ?? [];
  // Responsive poster: phones get the 800px WebP, desktops up to 2000px.
  $poster = _clau3_responsive_media($paragraph, 'field_image', 'hero');
  if ($poster) {
    $poster['#attributes']['class'][] = 'hero__poster';
    $poster['#attributes']['fetchpriority'] = 'high';
    unset($poster['#attributes']['loading']);
  }
  $variables['hero_poster'] = $poster;
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--card.html.twig.
 */
function clau3_preprocess_paragraph__card(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['card_image'] = _clau3_responsive_media($paragraph, 'field_image', 'card');
  $variables['card_text'] = $variables['content']['field_text'] ?? [];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--card-row.html.twig.
 */
function clau3_preprocess_paragraph__card_row(array &$variables): void {
  $variables['row_cards'] = $variables['content']['field_cards'] ?? [];
}

/**
 * Render array for a media image field through a responsive image style.
 */
function _clau3_responsive_media($entity, string $field, string $responsive_style): array {
  if (!$entity->hasField($field) || $entity->get($field)->isEmpty()) {
    return [];
  }
  $media = $entity->get($field)->entity;
  if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return [];
  }
  $item = $media->get('field_media_image')->first();
  $file = $item->entity;
  if (!$file) {
    return [];
  }
  return [
    '#theme' => 'responsive_image',
    '#responsive_image_style_id' => $responsive_style,
    '#uri' => $file->getFileUri(),
    '#attributes' => ['alt' => $item->alt ?? '', 'loading' => 'lazy'],
    '#cache' => ['tags' => $media->getCacheTags()],
  ];
}

/**
 * Items for the events section strip, or NULL when the path is not an events view.
 *
 * Static on purpose: the three paths exist (two landing pages and the map
 * view page) and need no controller.
 */
function _clau3_events_strip(string $current_path): ?array {
  $items = [
    ['title' => t('Upcoming'), 'url' => '/events'],
    ['title' => t('Past'), 'url' => '/events/past-events'],
    ['title' => t('Map'), 'url' => '/events/map'],
  ];
  $current_path = rtrim($current_path, '/');
  $is_events = FALSE;
  foreach ($items as &$item) {
    $item['current'] = $item['url'] === $current_path;
    $is_events = $is_events || $item['current'];
  }
  return $is_events ? $items : NULL;
}

/**
 * Variables for node--event--full.html.twig.
 */
function _clau3_preprocess_event_full(array &$variables, $node): void {
  $variables['event_image'] = _clau3_responsive_media($node, 'field_background_media', 'hero');
  if ($variables['event_image']) {
    unset($variables['event_image']['#attributes']['loading']);
    $variables['event_image']['#attributes']['fetchpriority'] = 'high';
  }

  $start = (int) ($node->get('field_when')->value ?? 0);
  $end = (int) ($node->get('field_when')->end_value ?? $start);
  $variables['event_is_past'] = $end > 0 && $end < \Drupal::time()->getRequestTime();

  // Date line: the formatted smart date, or the day only when the time is TBC.
  $when = '';
  if ($start) {
    if (!empty($node->get('field_time_tbc')->value)) {
      $when = \Drupal::service('date.formatter')->format($start, 'custom', 'D j M Y') . ', ' . t('time TBC');
    }
    else {
      $rendered = $variables['content']['field_when'] ?? [];
      $when = trim(strip_tags((string) \Drupal::service('renderer')->renderInIsolation($rendered)));
    }
  }
  $variables['event_when'] = $when;
  $variables['event_venue'] = $node->get('field_venue')->entity ? $node->get('field_venue')->entity->label() : '';

  // Organiser link from the tickets call-to-action paragraph.
  $variables['event_tickets_url'] = $variables['event_tickets_label'] = $variables['event_tickets_domain'] = '';
  if (!$node->get('field_tickets')->isEmpty() && ($cta = $node->get('field_tickets')->entity) && !$cta->get('field_link')->isEmpty()) {
    $link = $cta->get('field_link')->first();
    try {
      $url = $link->getUrl();
      $variables['event_tickets_url'] = $url->toString();
      $variables['event_tickets_label'] = $link->title ?: (string) t('Tickets and details');
      if ($url->isExternal()) {
        $host = parse_url($url->getUri(), PHP_URL_HOST) ?: '';
        $variables['event_tickets_domain'] = preg_replace('/^www\./', '', $host);
      }
    }
    catch (\Exception $e) {
      // A broken link on an old event is not worth a page error.
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view--events--map.html.twig.
 */
function clau3_preprocess_views_view__events__map(array &$variables): void {
  $variables['events_strip'] = _clau3_events_strip('/events/map');
}
