<article class="event-card">
  <a class="event-card__link" href="{{ url }}">
    {% set image_html = block('image')|trim %}
    <div class="event-card__media{{ image_html ? '' : ' event-card__media--empty' }}">{{ image_html|raw }}</div>
    <div class="event-card__body">
      <div class="event-card__date">{% block date %}{% endblock %}</div>
      <h3 class="event-card__title">{{ title }}</h3>
      {% if venue %}<p class="event-card__venue">{{ venue }}</p>{% endif %}
    </div>
  </a>
</article>
