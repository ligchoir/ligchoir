<article class="card">
  <a class="card__link" href="{{ url }}">
    {% set image_html = block('image')|trim %}
    <div class="card__media{{ image_html ? '' : ' card__media--empty' }}">{{ image_html|raw }}</div>
    <div class="card__body">
      <h3 class="card__heading">{{ heading }}</h3>
      <div class="card__text">{% block text %}{% endblock %}</div>
      {% if link_text %}<span class="card__cta ligc-more">{{ link_text }}</span>{% endif %}
    </div>
  </a>
</article>
