# https://drupal.stackexchange.com/a/282548/1082
# theme_name.theme file
function clau_preprocess_block(&$variables) {
  if ($variables['plugin_id'] == 'block-todaysdate') {
    $variables['#cache']['max-age'] = 0;
  }
}
